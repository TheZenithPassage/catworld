@startuml
skinparam classAttributeIconSize 0

package "catworld.domain" {

  abstract class Auditable {
    +Instant createdAt
    +Instant updatedAt
  }

  class Owner extends Auditable {
    +UUID id
    +String fullName  <<NotNull>>
    +String address
    +String primaryPhone  <<NotNull>>
    +String secondaryPhone
    +String secondaryPhoneName
    +String instagram
    +String facebook
    +UserAccount createdBy  <<NotNull>>
  }

  class Vet extends Auditable {
    +UUID id
    +String name  <<NotNull>>
    +String address
    +String phoneNumber
    +UserAccount createdBy  <<NotNull>>
  }

  enum Sex {
    MALE
    FEMALE
  }

  class Cat extends Auditable {
    +UUID id
    +String name  <<NotNull>>
    +LocalDate birthDate  <<NotNull>>
    +Sex sex  <<NotNull>>
    +String breed
    +String coat
    +String color
    +String foodBrand
    +String litterBrand
    +String personality
    +String lastInternalDewormerName
    +LocalDate lastInternalDewormingDate
    +String lastExternalDewormerName
    +LocalDate lastExternalDewormingDate
    +LocalDate lastTripleFelineDate
    +LocalDate lastRabiesDate
    +UserAccount createdBy  <<NotNull>>
  }

  enum StayStatus <<computed>> {
    RESERVED
    CHECKED_IN
    CHECKED_OUT
    CANCELLED
  }

  class Stay extends Auditable {
    +UUID id
    +LocalDateTime startAt  <<NotNull>>
    +LocalDateTime endAt    <<NotNull>>
    +LocalDateTime cancelledAt
    +String notes
    +BigDecimal retainedNightlyRate  <<Decimal(19,0),Nullable>>
    +BigDecimal agreedAmount  <<Decimal(19,0),Nullable>>
    +StayStatus status  <<Transient/Computed>>
    +UserAccount createdBy  <<NotNull>>
  }

  class StayCat {
    +Stay stay
    +Cat cat
  }

  enum UserRole {
    ADMIN
    STAFF
  }

  class UserAccount extends Auditable {
    +UUID id
    +String username  <<NotNull,Unique>>
    +String passwordHash  <<NotNull>>
    +UserRole role  <<NotNull>>
    +boolean enabled  <<NotNull>>
  }

  enum NightlyReferenceRateCategory {
    ONE_CAT
    TWO_CATS
    THREE_PLUS_CATS
    +int minimumCatCount
  }

  class NightlyReferenceRate extends Auditable {
    +NightlyReferenceRateCategory category  <<Id,NotNull>>
    +BigDecimal nightlyRate  <<Decimal(19,0),Nullable>>
  }

  class NightlyReferenceRateChange {
    +UUID id
    +NightlyReferenceRateCategory category  <<NotNull,Immutable>>
    +BigDecimal previousNightlyRate  <<Decimal(19,0),Nullable,Immutable>>
    +BigDecimal newNightlyRate  <<Decimal(19,0),Nullable,Immutable>>
    +UserAccount changedBy  <<NotNull,Immutable>>
    +Instant changedAt  <<NotNull,Immutable>>
  }

  class StayPricingDecision {
    +UUID id
    +UUID stayId  <<NotNull,Immutable>>
    +BigDecimal retainedNightlyRate  <<Decimal(19,0),Nullable,Immutable>>
    +Long previousNumberOfNights  <<Nullable,Immutable>>
    +long newNumberOfNights  <<NotNull,Immutable>>
    +BigDecimal previousAgreedAmount  <<Decimal(19,0),Nullable,Immutable>>
    +BigDecimal newAgreedAmount  <<Decimal(19,0),NotNull,Immutable>>
    +UserAccount decidedBy  <<NotNull,Immutable>>
    +Instant decidedAt  <<NotNull,Immutable>>
    +String reason  <<Nullable,Immutable>>
  }

  class StayAgreedAmountCorrection {
    +UUID id
    +UUID stayId  <<NotNull,Immutable>>
    +BigDecimal previousAgreedAmount  <<Decimal(19,0),Nullable,Immutable>>
    +BigDecimal newAgreedAmount  <<Decimal(19,0),NotNull,Immutable>>
    +UserAccount decidedBy  <<NotNull,Immutable>>
    +Instant decidedAt  <<NotNull,Immutable>>
    +String reason  <<NotBlank,Immutable>>
  }

  Owner "1" o-- "0..*" Cat : owns >
  Vet   "0..1" o-- "0..*" Cat : treats >
  Owner "1" o-- "0..*" Stay : books >
  Stay  "1" *-- "1..*" StayCat : includes >
  Cat   "1" o-- "0..*" StayCat : participates >
  UserAccount "1" <-- "0..*" Owner : createdBy
  UserAccount "1" <-- "0..*" Cat : createdBy
  UserAccount "1" <-- "0..*" Vet : createdBy
  UserAccount "1" <-- "0..*" Stay : createdBy
  NightlyReferenceRateCategory "1" <-- "1" NightlyReferenceRate : category
  NightlyReferenceRateCategory "1" <-- "0..*" NightlyReferenceRateChange : category
  UserAccount "1" <-- "0..*" NightlyReferenceRateChange : changedBy
  UserAccount "1" <-- "0..*" StayPricingDecision : decidedBy
  UserAccount "1" <-- "0..*" StayAgreedAmountCorrection : decidedBy
}

note right of Stay
status is DYNAMIC:
- cancelledAt != null => CANCELLED
- now < startAt => RESERVED
- startAt <= now < endAt => CHECKED_IN
- now >= endAt => CHECKED_OUT
end note

note bottom of Stay
Rules:
- endAt > startAt
- at least 1 cat per stay
- all cats in a stay must belong to the same owner
- no overlapping stays per cat, ignoring cancelled stays
- retained rate is null or positive; agreed amount is null or non-negative
end note

note bottom of StayCat
Each row represents one link
between a stay and a cat.
The logical key is (stay, cat).
end note

note bottom of NightlyReferenceRate
Exactly one current row exists for each
minimum cat-count threshold: 1, 2 or 3.
Threshold 3 identifies THREE_PLUS_CATS.
A null rate means unavailable.
end note

note bottom of NightlyReferenceRateChange
Append-only audit snapshot.
Exactly one of previous/new may be null,
and a transition must change the value.
end note

note bottom of StayPricingDecision
Append-only pricing confirmation.
stayId is indexed evidence, not an
operational Stay relationship, so it
survives deletion of the stay.
end note

note bottom of StayAgreedAmountCorrection
Append-only administrative correction.
stayId is indexed evidence, not an
operational Stay relationship. A nullable
previous amount supports explicit legacy
initialization. Reason is always required.
end note

@enduml
