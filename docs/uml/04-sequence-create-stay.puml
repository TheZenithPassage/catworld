@startuml
actor Client as client
participant "StayController" as controller
participant "StayService" as service
participant "CatRepository" as catRepo
participant "StayRepository" as stayRepo
participant "StayCatRepository" as stayCatRepo

client -> controller: POST /stays (catIds, startAt, endAt, notes)
controller -> service: createStay(cmd)

service -> service: validate(catIds no vacío)
service -> service: validate(no duplicados)
service -> service: validate(endAt > startAt)
service -> catRepo: findAllById(catIds)
catRepo --> service: List<Cat>

alt faltan cats o lista vacía
  service --> controller: 400 / 404
  controller --> client: error
else cats encontrados
  service -> service: validate(todos comparten el mismo owner)
  service -> stayRepo: existsOverlapForAnyCat(catIds, startAt, endAt)
  stayRepo --> service: true/false

  alt overlaps = true
    service --> controller: 409 Conflict (overlap)
    controller --> client: 409
  else overlaps = false
    service -> service: owner = cats[0].owner
    service -> stayRepo: save(Stay)
    stayRepo --> service: Stay saved
    service -> stayCatRepo: saveAll(StayCat rows)
    stayCatRepo --> service: links saved
    service --> controller: StayResponseDto
    controller --> client: 201 Created
  end
end

@enduml
