@startuml
actor "Admin / Staff" as client
participant "StayController" as controller
participant "StayService" as service
participant "StayMapper" as mapper
database "Cat / rate / transfer repositories" as basisRepo
database "StayRepository" as stayRepo
database "StayPricingDecisionRepository" as auditRepo

client -> controller: POST /api/stays/pricing-preview\n(dates, catIds, transfer flags)
controller -> service: previewCreationPricing(request)
service -> basisRepo: read cats, nightly and transfer rates
basisRepo --> service: authoritative preview basis
service --> controller: nights, retained rates, suggestion, confirmation snapshot
controller --> client: 200 OK with authoritative preview
note over client,service
Preview is read-only. The final mutation re-resolves
the basis; a preview is not a reservation.
end note

client -> controller: POST /api/stays\n(dates, catIds, transfer flags,\npricingDecision, confirmation)
controller -> controller: @Valid StayRequestDTO
alt missing or invalid required fields
  controller --> client: 400 Bad Request
else structurally valid request
  controller -> service: createStay(request) in transaction
  service -> service: validate endAt > startAt
  service -> mapper: toEntity(request)
  mapper --> service: Stay
  service -> basisRepo: resolve each cat
  service -> service: require same owner and no active overlap
  service -> service: authorize persisted user and check vaccine coverage
  service -> basisRepo: lock current transfer and nightly basis
  basisRepo --> service: current rates
  service -> service: derive nights and complete suggestion
  service -> service: compare all confirmation fields\nwith re-resolved basis
  service -> service: validate agreed amount and reason

  alt missing cat
    service --> controller: ResourceNotFoundException
    controller --> client: 404 Not Found
  else overlap or stale pricing confirmation
    service --> controller: ConflictException or StalePricingConfirmationException
    controller --> client: 409 Conflict
  else invalid dates, owner, vaccine or pricing decision
    service --> controller: validation / authorization exception
    controller --> client: corresponding 400 / 403 / 409 response
  else valid confirmed stay
    service -> stayRepo: save Stay and StayCat links
    stayRepo --> service: saved Stay
    service -> auditRepo: saveAndFlush immutable pricing decision
    service -> mapper: toResponseDTO(saved Stay)
    mapper --> service: StayResponseDTO
    service --> controller: StayResponseDTO
    controller --> client: 201 Created
  end
end

@enduml
