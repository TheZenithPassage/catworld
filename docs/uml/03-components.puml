@startuml
skinparam componentStyle rectangle

actor "Usuario" as user

package "CatWorld (Spring Boot Monolith)" {
  [REST Controllers] as c
  [DTO + Mapper] as m
  [Services] as s
  [Domain (Entities + Rules)] as d
  [Repositories (JPA)] as r
}

database "MySQL (Docker)" as db

user --> c
c --> m
m --> s
s --> d
s --> r
r --> db

note right of s
Reglas de negocio relevantes:
- endAt > startAt
- al menos un cat por stay
- todos los cats de una stay comparten owner
- owner de stay coherente con cats
- no solapes por cat
end note

@enduml
